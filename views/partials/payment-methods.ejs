<%#
  Accepted payment methods.

  Shows the uploaded logo when there is one and the method name when there is
  not, so the row is never empty and never a broken image. The service page used
  to render plain text pills regardless, which meant an operator who uploaded a
  bKash logo still saw the word "bKash".

  Expects `payments` (the res.locals shape) and an optional `size` of
  'sm' | 'md'.
%>
<%
  var size = typeof size === 'undefined' ? 'md' : size;
  var methods = [
    { key: 'bkash', label: 'bKash', data: payments.bkash },
    { key: 'nagad', label: 'Nagad', data: payments.nagad },
    { key: 'rocket', label: 'Rocket', data: payments.rocket },
    { key: 'card', label: 'Card', data: payments.card }
  ].filter(function (m) { return m.data && m.data.enabled; });
%>
<% if (methods.length) { %>
  <div class="pay-methods pay-methods-<%= size %>">
    <% methods.forEach(function (method) { %>
      <% if (method.data.logo) { %>
        <span class="pay-chip pay-chip-logo" title="<%= method.label %>">
          <img src="<%= helpers.url(method.data.logo) %>" alt="<%= method.label %>" loading="lazy">
        </span>
      <% } else { %>
        <span class="pay-chip"><%= method.label %></span>
      <% } %>
    <% }); %>
  </div>
<% } %>
