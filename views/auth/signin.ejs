<div class="auth-head">
  <h1>Welcome back</h1>
  <p>Sign in to manage your orders, payments and support tickets.</p>
</div>

<%- include('../partials/flash') %>

<% if (notice) { %>
  <div class="alert alert-success" role="status">
    <svg><use href="#i-check-circle"/></svg>
    <div><%= notice %></div>
  </div>
<% } %>

<% if (googleAuth.enabled && googleAuth.onLogin) { %>
  <a href="<%= helpers.url('/auth/google?next=' + encodeURIComponent(next || '/account')) %>" class="google-btn">
    <svg><use href="#i-google"/></svg>
    Continue with Google
  </a>
  <div class="divider">or sign in with email</div>
<% } %>

<form action="<%= helpers.url('/signin') %>" method="POST" data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="next" value="<%= next %>">
  <div class="hp-field"><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"></div>

  <div class="form-group">
    <label class="form-label" for="email">Email address <span class="req">*</span></label>
    <div class="input-group">
      <svg class="input-icon"><use href="#i-mail"/></svg>
      <input type="email" id="email" name="email" class="form-control" required maxlength="191"
             autocomplete="email" placeholder="you@business.com" autofocus
             value="<%= form && form.email ? form.email : '' %>">
    </div>
    <% if (errors && errors.email) { %><span class="form-error"><%= errors.email %></span><% } %>
  </div>

  <div class="form-group">
    <div class="auth-meta" style="margin-bottom:8px">
      <label class="form-label" for="password" style="margin-bottom:0">Password <span class="req">*</span></label>
      <a href="<%= helpers.url('/forgot-password') %>" style="font-size:.8438rem;font-weight:600">Forgot password?</a>
    </div>
    <div class="input-group">
      <svg class="input-icon"><use href="#i-lock"/></svg>
      <input type="password" id="password" name="password" class="form-control has-action" required
             autocomplete="current-password" placeholder="Your password">
      <button type="button" class="input-action" data-toggle-password="password" aria-label="Show password">
        <svg style="width:17px;height:17px"><use href="#i-eye"/></svg>
      </button>
    </div>
    <% if (errors && errors.password) { %><span class="form-error"><%= errors.password %></span><% } %>
  </div>

  <label class="checkbox" style="margin-bottom:22px">
    <input type="checkbox" name="remember" value="1">
    <span>Keep me signed in on this device</span>
  </label>

  <% if (captcha.enabled && settings.captcha_on_login === '1') { %>
    <%- include('../partials/recaptcha', { captcha: { siteKey: captcha.siteKey, mode: captcha.mode } }) %>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>

  <button type="submit" class="btn btn-primary btn-block btn-lg">
    Sign in
    <svg><use href="#i-log-in"/></svg>
  </button>
</form>

<p class="auth-foot">
  New to <%= site.name %>? <a href="<%= helpers.url('/signup' + (next ? '?next=' + encodeURIComponent(next) : '')) %>">Create an account</a>
</p>
