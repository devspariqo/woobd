<div class="auth-head">
  <h1>Forgot your password?</h1>
  <p>Enter the email address on your account and we will send you a link to set a new password.</p>
</div>

<%- include('../partials/flash') %>

<% if (sent) { %>
  <div class="alert alert-success" role="status">
    <svg><use href="#i-check-circle"/></svg>
    <div>
      <strong>Check your inbox.</strong> If an account exists for that address, a reset link is on its way.
      The link expires in one hour.
    </div>
  </div>
  <p style="font-size:.875rem;color:var(--text-soft);margin-bottom:24px">
    Nothing arrived? Check your spam folder, or
    <a href="<%= helpers.url('/forgot-password') %>">try again</a>.
  </p>
  <a href="<%= helpers.url('/signin') %>" class="btn btn-outline btn-block">
    <svg><use href="#i-chevron-left"/></svg>
    Back to sign in
  </a>
<% } else { %>
  <form action="<%= helpers.url('/forgot-password') %>" method="POST" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label class="form-label" for="email">Email address <span class="req">*</span></label>
      <div class="input-group">
        <svg class="input-icon"><use href="#i-mail"/></svg>
        <input type="email" id="email" name="email" class="form-control" required maxlength="191"
               autocomplete="email" placeholder="you@business.com" autofocus>
      </div>
      <% if (errors && errors.email) { %><span class="form-error"><%= errors.email %></span><% } %>
    </div>

    <% if (captcha.enabled && settings.captcha_on_login === '1') { %>
      <%- include('../partials/recaptcha', { captcha: { siteKey: captcha.siteKey, mode: captcha.mode } }) %>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <% } %>

    <button type="submit" class="btn btn-primary btn-block btn-lg">
      Send reset link
      <svg><use href="#i-send"/></svg>
    </button>
  </form>

  <p class="auth-foot">
    Remembered it? <a href="<%= helpers.url('/signin') %>">Back to sign in</a>
  </p>
<% } %>
