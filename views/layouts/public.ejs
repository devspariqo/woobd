<%#
  Safe defaults for every local this layout reads.

  These normally come from the context middleware - which queries the database,
  so it never runs when the database is unreachable. That is precisely when an
  error page has to render, and without these defaults the LAYOUT throws: the
  handler catches the original fault, then the render fails too, Express falls
  through to its built-in handler, and the visitor sees a bare
  "Internal Server Error" with the real cause buried in the log.

  A layout must never depend on middleware having succeeded.
%>
<%
  var site = typeof site !== 'undefined' && site ? site : { name: 'WooBD.Com', tagline: '', description: '', email: '', phone: '', whatsapp: '', whatsappLink: '', address: '' };
  var seo = Object.assign(
    { title: site.name, description: site.description || '', keywords: '', robots: 'index,follow', canonical: '', ogImage: '' },
    typeof seo !== 'undefined' && seo ? seo : {}
  );
  var defaultColorMode = typeof defaultColorMode !== 'undefined' && defaultColorMode ? defaultColorMode : 'light';
  var pageTitle = typeof pageTitle !== 'undefined' ? pageTitle : '';
  var pageDescription = typeof pageDescription !== 'undefined' ? pageDescription : '';
  var pageRobots = typeof pageRobots !== 'undefined' ? pageRobots : '';
  var pageCanonical = typeof pageCanonical !== 'undefined' ? pageCanonical : '';
%>
<!DOCTYPE html>
<html lang="en" data-theme="<%= defaultColorMode %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Exposed so JavaScript can send it. The chat widget posts JSON, which
      the global CSRF check cannot read from a form field, so without this
      every message is rejected as an expired session. %>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="theme-color" content="<%= defaultColorMode === 'dark' ? '#0c0e1a' : '#ffffff' %>">

  <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' - ' + site.name : seo.title %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : seo.description %>">
  <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
  <meta name="robots" content="<%= typeof pageRobots !== 'undefined' && pageRobots ? pageRobots : seo.robots %>">
  <link rel="canonical" href="<%= typeof pageCanonical !== 'undefined' && pageCanonical ? pageCanonical : seo.canonical %>">

  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : seo.title %>">
  <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : seo.description %>">
  <meta property="og:url" content="<%= typeof pageCanonical !== 'undefined' && pageCanonical ? pageCanonical : seo.canonical %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } else if (seo.ogImage) { %><meta property="og:image" content="<%= seo.ogImage %>"><% } %>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : seo.title %>">
  <meta name="twitter:description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : seo.description %>">

  <link rel="icon" type="image/svg+xml" href="<%= site.favicon %>">
  <link rel="apple-touch-icon" href="<%= site.favicon %>">

  <% if (seo.verification) { %><meta name="google-site-verification" content="<%= seo.verification %>"><% } %>

  <%#
    Warm the reCAPTCHA origins before the widget is needed.

    The script itself is loaded at the bottom of the form's page, but the
    handshake to google.com and the iframe from gstatic.com are two more
    origins the browser has to resolve and connect to. Doing that here costs
    nothing on pages without a captcha and saves a round trip on the ones with.
  %>
  <% if (captcha.enabled) { %>
    <link rel="preconnect" href="https://www.google.com">
    <link rel="preconnect" href="https://www.gstatic.com" crossorigin>
  <% } %>

  <%#
    Fonts, loaded without blocking the first paint.

    A plain stylesheet link to fonts.googleapis.com is render-blocking against
    a third-party origin: the browser will not paint until the CSS arrives and
    it has discovered the font files behind it. On a slow mobile connection
    that is several hundred milliseconds of blank screen, and it delays the
    largest element on the page.

    `media="print"` makes the browser fetch the sheet without applying it, so
    it downloads in parallel and nothing waits on it. The onload swaps the
    media and it applies the moment it lands. The noscript copy covers
    JavaScript being off, where onload would never fire and the custom font
    would never be used.

    The swap is safe because the CSS names system-ui immediately after the
    custom family, so text is legible throughout - and both families are the
    same width class, so it is a font change rather than a layout shift.
  %>
  <%
    // Self-hosted when scripts/fetch-fonts.js has been run, which is the case
    // on any checkout that has run the build. Falls back to Google otherwise.
    var localFonts = helpers.localFonts();

    var fontHref = 'https://fonts.googleapis.com/css2?family='
      + encodeURIComponent(fonts.heading).replace(/%20/g, '+') + ':wght@400;500;600;700;800'
      + (fonts.body === fonts.heading ? '' : '&family=' + encodeURIComponent(fonts.body).replace(/%20/g, '+') + ':wght@400;500;600')
      + '&display=swap';
  %>

  <% if (localFonts) { %>
    <%#
      Same origin, and the two files the first paint needs are preloaded.

      Loading these from Google cost two extra origins before the first paint -
      DNS, TLS and a round trip to googleapis.com for the stylesheet, then the
      same again to gstatic.com for the file. Measured under Lighthouse's mobile
      throttling, removing the webfonts entirely moved performance 91 → 100,
      FCP 2.8s → 0.9s. Self-hosting keeps the typeface and drops the third
      parties.

      `crossorigin` is required on a font preload: fonts are fetched in CORS
      mode, and a preload without it is discarded and fetched a second time.

      The stylesheet is deliberately render-blocking, unlike the Google one it
      replaces. It is 3.6 KB from our own origin, and applying it before the
      first paint is what stops the text being laid out twice - once in the
      fallback and again when the real font arrives.
    %>
    <% localFonts.preload.forEach(function (file) { %>
      <link rel="preload" as="font" type="font/woff2" crossorigin
            href="<%= helpers.url('/assets/fonts/' + file) %>">
    <% }); %>
    <link rel="stylesheet" href="<%= helpers.versioned(localFonts.css) %>">
  <% } else { %>
    <%#
      The Google fallback, unchanged: non-blocking, with a preconnect to each
      origin it needs. Only reached when the fonts have not been fetched.
    %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="<%= fontHref %>">
    <link rel="stylesheet" href="<%= fontHref %>" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="<%= fontHref %>"></noscript>
  <% } %>

  <link rel="stylesheet" href="<%= helpers.versioned('/assets/css/theme.css') %>">

  <%# Site tokens come from the settings table, so the admin panel can restyle
      the whole public site without a deploy. %>
  <style>
    :root {
      --primary: <%= theme.primary %>;
      --primary-dark: <%= theme.primaryDark %>;
      --secondary: <%= theme.secondary %>;
      --success: <%= theme.success %>;
      --danger: <%= theme.danger %>;
      --warning: <%= theme.warning %>;
      --bg: <%= theme.bgLight %>;
      --bg-alt: <%= theme.bgLightAlt %>;
      --text: <%= theme.textLight %>;
      --radius: <%= theme.radius %>;
      --font-heading: '<%= fonts.heading %>', system-ui, sans-serif;
      --font-body: '<%= fonts.body %>', system-ui, sans-serif;
      --fs-base: <%= fonts.baseSize %>px;
      --fw-heading: <%= fonts.headingWeight %>;
    }
    [data-theme='dark'] {
      --bg: <%= theme.bgDark %>;
      --bg-alt: <%= theme.bgDarkAlt %>;
      --text: <%= theme.textDark %>;
    }
  </style>

  <%# Set the theme before first paint. Without this the page renders light and
      then snaps to dark, which reads as a flash on every navigation. %>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('woobd-theme');
        var fallback = '<%= defaultColorMode %>';
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (prefersDark && fallback !== 'light' ? 'dark' : fallback));
      } catch (e) { /* private mode */ }
    })();
  </script>

  <%# extraHead carries pre-built markup (JSON-LD structured data), so it must
      be emitted RAW with the unescaped output tag. Using the escaped output tag
      makes EJS HTML-encode it, turning the script tags into entities and
      rendering the whole payload as visible text at the top of the page instead
      of registering it as structured data.
      Controllers build this with helpers.jsonLd(), which escapes the angle
      brackets and ampersands inside the JSON so page content cannot break out
      of the script block.
      (Note for future edits: do not write EJS tag syntax inside this comment -
      the parser treats an opening tag as the end of the comment.) %>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>

  <% if (seo.analyticsId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= seo.analyticsId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= seo.analyticsId %>');
  </script>
  <% } %>
</head>
<body>
  <a href="#main" class="sr-only sr-only-focusable">Skip to content</a>

  <%#
    Maintenance banner, shown only to signed-in staff.

    middleware/security.js deliberately lets staff through so they can preview
    the site - but that makes the switch look broken: an admin turns maintenance
    on, browses the site, sees it working normally, and concludes the setting
    does nothing. Nothing in the UI said otherwise.

    This says otherwise, and links to the page visitors actually get.
  %>
  <% if (typeof settings !== 'undefined' && settings.maintenance_mode === '1' && isStaff) { %>
    <div class="maintenance-banner" role="status">
      <svg><use href="#i-alert"/></svg>
      <span>
        <strong>Maintenance mode is ON.</strong>
        Visitors see the maintenance page. You can see the site because you are signed in as staff.
      </span>
      <a href="<%= helpers.url('/maintenance-preview') %>" class="btn btn-sm btn-outline">View what visitors see</a>
      <a href="<%= helpers.url('/' + adminPath + '/settings?group=maintenance') %>" class="btn btn-sm btn-ghost">Turn it off</a>
    </div>
  <% } %>

  <%- include('../partials/topbar') %>
  <%- include('../partials/header') %>
  <%- include('../partials/mobile-menu') %>

  <main id="main">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <%- include('../partials/chat-widget') %>
  <%- include('../partials/scripts') %>
</body>
</html>
