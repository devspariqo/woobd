<!DOCTYPE html>
<html lang="en" data-theme="<%= defaultColorMode %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> - <%= site.name %></title>
  <meta name="robots" content="noindex,nofollow,noarchive">
  <link rel="icon" type="image/svg+xml" href="<%= site.favicon %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= encodeURIComponent(fonts.heading).replace(/%20/g, '+') %>:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= helpers.url('/assets/css/theme.css') %>">

  <script>
    (function () {
      try {
        var stored = localStorage.getItem('woobd-theme');
        if (stored) document.documentElement.setAttribute('data-theme', stored);
      } catch (e) {}
    })();
  </script>

  <style>
    :root {
      --primary: <%= theme.primary %>;
      --primary-dark: <%= theme.primaryDark %>;
      --secondary: <%= theme.secondary %>;
      --success: <%= theme.success %>;
      --danger: <%= theme.danger %>;
      --warning: <%= theme.warning %>;
      --surface: <%= theme.bgLight %>;
      --bg-alt: <%= theme.bgLightAlt %>;
      --text: <%= theme.textLight %>;
      --radius: <%= theme.radius %>;
      --font-heading: '<%= fonts.heading %>', system-ui, sans-serif;
      --font-body: '<%= fonts.body %>', system-ui, sans-serif;
    }
    [data-theme='dark'] {
      --surface: #161a2e;
      --bg-alt: <%= theme.bgDarkAlt %>;
      --text: <%= theme.textDark %>;
    }

    /* The staff sign-in screen is deliberately standalone: no sidebar, no
       header, nothing that reveals the panel exists behind it. */
    .admin-auth-body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 34px 20px;
      background:
        radial-gradient(1100px 520px at 12% -8%, rgba(91, 33, 240, .13), transparent 62%),
        radial-gradient(900px 480px at 92% 108%, rgba(56, 132, 255, .11), transparent 60%),
        var(--bg-alt);
    }

    .admin-auth-card {
      width: 100%;
      max-width: 424px;
      padding: 38px 34px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 18px 52px rgba(20, 22, 40, .12);
    }

    .admin-auth-brand { text-align: center; margin-bottom: 24px; }
    .admin-auth-brand img { max-height: 44px; width: auto; margin: 0 auto 15px; display: block; }
    .admin-auth-brand h1 { font-size: 1.375rem; margin-bottom: 6px; }
    .admin-auth-brand p { font-size: .875rem; color: var(--text-soft); margin: 0; }

    .admin-auth-foot {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: .8125rem;
      color: var(--text-soft);
    }

    /* Google's widget cannot be restyled - only the space around it. */
    .recaptcha-wrap { margin-bottom: 20px; min-height: 78px; }
  </style>
</head>
<body class="admin-auth-body">

  <main class="admin-auth-card">
    <div class="admin-auth-brand">
      <%#
        Both variants, swapped by CSS on the theme - same mechanism as the site
        header. This used to hardcode site.logoDark, which is the artwork drawn
        for a dark background: on the default light theme it put light-coloured
        artwork on a light card and the logo all but vanished.
      %>
      <img src="<%= site.logoLight %>" alt="<%= site.name %>" class="logo-for-light">
      <img src="<%= site.logoDark %>" alt="<%= site.name %>" class="logo-for-dark">
      <h1>Staff sign in</h1>
      <p>Restricted area — authorised personnel only.</p>
    </div>

    <%- include('../partials/flash') %>
    <%- body %>
  </main>

  <%- include('../partials/icons') %>
  <% if (typeof showCaptcha !== 'undefined' && showCaptcha) { %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
  <script src="<%= helpers.url('/assets/js/main.js') %>" defer></script>
</body>
</html>
