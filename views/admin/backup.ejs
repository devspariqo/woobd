<%
  const url = function (p) { return helpers.url('/' + adminPath + '/backup' + p); };
  const totalRows = (inventory || []).reduce(function (sum, t) { return sum + (Number(t.row_estimate) || 0); }, 0);
  const totalKb = (inventory || []).reduce(function (sum, t) { return sum + (Number(t.kb) || 0); }, 0);
%>

<div class="panel" style="margin-bottom:20px">
  <div class="panel-head">
    <h2 style="font-size:.9375rem;font-weight:700;margin:0">Download a backup</h2>
    <span style="font-size:.8125rem;color:var(--text-soft)">.sql file, ready for mysql restore</span>
  </div>
  <div class="panel-body">
    <p style="font-size:.875rem;color:var(--text-muted);margin:0 0 16px;line-height:1.7">
      Exports every table as <code>DROP TABLE</code> + <code>CREATE TABLE</code> +
      <code>INSERT</code> statements, so the file restores into an empty database as well
      as an existing one. The dump is generated by the application rather than
      <code>mysqldump</code>, which is not guaranteed to exist on shared hosting.
    </p>

    <dl class="meta-list" style="margin-bottom:18px">
      <div><dt>Database</dt><dd><code><%= dbName %></code></dd></div>
      <div><dt>Tables</dt><dd><strong><%= (tables || []).length %></strong></dd></div>
      <div><dt>Rows (approx.)</dt><dd><%= totalRows.toLocaleString('en-US') %></dd></div>
      <div><dt>Size on disk</dt><dd><%= helpers.fileSize(totalKb * 1024) %></dd></div>
    </dl>

    <a href="<%= url('/download') %>" class="btn btn-primary">
      <svg><use href="#i-download"/></svg> Download SQL backup
    </a>
  </div>
</div>

<div class="alert alert-info" role="status" style="margin-bottom:20px">
  <svg><use href="#i-info"/></svg>
  <div>
    <strong>Restoring a backup is a command-line job.</strong>
    Download the file, then run
    <code>mysql -u USER -p DBNAME &lt; backup.sql</code> on the server. This panel does not
    offer an upload-and-restore button on purpose: an import runs arbitrary SQL against the
    live database, and a mistake there is unrecoverable.
  </div>
</div>

<div class="panel">
  <div class="panel-head">
    <h2 style="font-size:.9375rem;font-weight:700;margin:0">What is in the database</h2>
  </div>
  <div class="table-wrap">
    <table class="dash-table">
      <thead>
        <tr><th>Table</th><th class="num">Rows (approx.)</th><th class="num">Size</th></tr>
      </thead>
      <tbody>
        <% (inventory || []).forEach(function (table) { %>
          <tr>
            <td><code style="font-size:.8125rem"><%= table.name %></code></td>
            <td class="num"><%= (Number(table.row_estimate) || 0).toLocaleString('en-US') %></td>
            <td class="num" style="color:var(--text-soft)"><%= helpers.fileSize((Number(table.kb) || 0) * 1024) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    <span style="font-size:.75rem;color:var(--text-soft)">
      Row counts are InnoDB estimates from <code>information_schema</code> and can differ
      slightly from an exact count.
    </span>
  </div>
</div>
