<%
  /**
   * One chat transcript.
   *
   * The messages are shown exactly as they were sent. There is no edit or
   * delete on an individual message on purpose - this is the record of what a
   * visitor was actually told, and the panel that can rewrite it is the panel
   * that makes it worthless as evidence.
   */
  const base = '/' + adminPath + '/chat';
  const url = function (p) { return helpers.url(base + p); };
  const who = conversation.visitor_name || conversation.customer_name || 'Guest visitor';
  const contact = conversation.visitor_email || conversation.customer_email || '';
%>

<div class="chat-detail">
  <div class="panel chat-transcript-panel">
    <div class="panel-head">
      <h2 style="margin:0;font-size:1rem">
        Transcript
        <span class="pill pill-<%= conversation.status === 'open' ? 'success' : 'muted' %>" style="margin-left:8px">
          <%= helpers.humanise(conversation.status) %>
        </span>
      </h2>
      <span style="font-size:.8125rem;color:var(--text-soft)">
        <%= messages.length %> message<%= messages.length === 1 ? '' : 's' %>
      </span>
    </div>

    <div class="panel-body">
      <% if (!messages.length) { %>
        <p style="color:var(--text-soft);margin:0">
          This conversation was opened but no message was ever sent.
        </p>
      <% } else { %>
        <div class="chat-thread">
          <% messages.forEach(function (m) { %>
            <div class="chat-bubble chat-bubble-<%= m.role === 'user' ? 'visitor' : (m.role === 'system' ? 'system' : 'assistant') %>">
              <div class="chat-bubble-head">
                <strong>
                  <% if (m.role === 'user') { %><%= who %>
                  <% } else if (m.role === 'system') { %>System
                  <% } else { %>WooBD Assistant<% } %>
                </strong>
                <time datetime="<%= new Date(m.created_at).toISOString() %>"><%= helpers.timeAgo(m.created_at) %></time>
              </div>
              <div class="chat-bubble-body"><%= m.content %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="chat-detail-side">
    <div class="panel">
      <div class="panel-head"><h2 style="margin:0;font-size:1rem">Visitor</h2></div>
      <div class="panel-body">
        <div class="cred-row" style="margin-bottom:12px">
          <span class="label">Name</span>
          <span><%= who %></span>
        </div>
        <div class="cred-row" style="margin-bottom:12px">
          <span class="label">Email</span>
          <span>
            <% if (contact) { %>
              <a href="mailto:<%= contact %>"><%= contact %></a>
            <% } else { %>
              <span style="color:var(--text-soft)">Not given</span>
            <% } %>
          </span>
        </div>
        <div class="cred-row" style="margin-bottom:12px">
          <span class="label">Account</span>
          <span>
            <% if (conversation.customer_id) { %>
              <a href="<%= helpers.url('/' + adminPath + '/customers/' + conversation.customer_id) %>">
                Signed in
              </a>
            <% } else { %>
              <span style="color:var(--text-soft)">Not signed in</span>
            <% } %>
          </span>
        </div>
        <div class="cred-row" style="margin-bottom:12px">
          <span class="label">Started</span>
          <span><%= helpers.timeAgo(conversation.created_at) %></span>
        </div>
        <div class="cred-row" style="margin-bottom:12px">
          <span class="label">Last active</span>
          <span><%= helpers.timeAgo(conversation.updated_at) %></span>
        </div>
        <% if (conversation.page_url) { %>
          <div class="cred-row" style="margin-bottom:12px">
            <span class="label">Page</span>
            <span><code style="font-size:.75rem;word-break:break-all"><%= conversation.page_url %></code></span>
          </div>
        <% } %>
        <% if (conversation.visitor_ip) { %>
          <div class="cred-row">
            <span class="label">IP</span>
            <span style="font-size:.8125rem;color:var(--text-soft)"><%= conversation.visitor_ip %></span>
          </div>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2 style="margin:0;font-size:1rem">Actions</h2></div>
      <div class="panel-body">
        <form method="post" action="<%= url('/' + conversation.id) %>" style="margin-bottom:10px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="<%= conversation.status === 'open' ? 'closed' : 'open' %>">
          <button type="submit" class="btn btn-outline btn-block">
            <svg><use href="#i-check"/></svg>
            <%= conversation.status === 'open' ? 'Mark as closed' : 'Reopen' %>
          </button>
        </form>

        <%
          // Deleting is admin-only, so the button is hidden rather than shown
          // and then refused - a control that always errors is worse than no
          // control.
          const canDelete = staff && staff.role === 'admin';
        %>
        <% if (canDelete) { %>
          <form method="post" action="<%= url('/' + conversation.id + '/delete') %>"
                data-confirm="Delete this conversation and all its messages? This cannot be undone.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-block">
              <svg><use href="#i-trash"/></svg>
              Delete conversation
            </button>
          </form>
        <% } %>

        <a href="<%= url('') %>" class="btn btn-ghost btn-block" style="margin-top:10px">
          Back to all conversations
        </a>
      </div>
    </div>
  </div>
</div>
