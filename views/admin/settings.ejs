<%#
  Admin settings.
  Expects: group, groups[], fields[], errors (optional), captchaConfigured,
  googleConfigured, adminPath, csrfToken, helpers, site.

  The whole page is generated from src/config/settings-schema.js. Each field is
  rendered by its declared `type`, so adding a setting to the registry makes it
  editable here with no change to this template.
%>
<%
  var base = '/' + adminPath;
  var settingsUrl = helpers.url(base + '/settings');
  var isHexColour = function (v) { return typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v); };
  // A setting whose key ends in _color is a colour even while it is empty.
  var isColourField = function (key, value) { return /_color$/.test(key) || isHexColour(value); };
  var currentGroupLabel = 'Settings';
  groups.forEach(function (g) { if (g.key === group) currentGroupLabel = g.label; });

  // Boolean keys in this group, so we can warn when a toggle is on but the
  // credentials it depends on are missing.
  var boolField = function (key) {
    var found = null;
    fields.forEach(function (f) { if (f.key === key) found = f; });
    return found;
  };
  var captchaToggles = ['captcha_on_login', 'captcha_on_signup', 'captcha_on_admin', 'captcha_on_contact']
    .map(boolField).filter(function (f) { return f && f.value === '1'; });
  var googleToggles = ['google_auth_on_login', 'google_auth_on_signup']
    .map(boolField).filter(function (f) { return f && f.value === '1'; });
%>

<div class="tab-bar" style="margin-bottom:20px">
  <% groups.forEach(function (g) { %>
    <a href="<%= settingsUrl %>?group=<%= g.key %>" class="<%= group === g.key ? 'active' : '' %>">
      <%= g.label %>
    </a>
  <% }); %>
</div>

<%#
  Connection warnings. These are the difference between "the toggle is on" and
  "the feature actually works" - a CAPTCHA switch with no keys silently does
  nothing, and that is worth saying out loud.
%>
<% if (group === 'security' && captchaToggles.length && !captchaConfigured) { %>
  <div class="alert alert-warning" role="status">
    <svg><use href="#i-alert"/></svg>
    <div>
      <strong>CAPTCHA is switched on but not configured.</strong>

      <%#
        Which half is missing, named. "Add both keys" is not an instruction
        when one of them is already saved - the operator pastes the same value
        twice and the warning does not change.
      %>
      <% if (!captchaSiteKeySet && !captchaSecretKeySet) { %>
        <strong>Neither key is saved</strong>, so no challenge is shown on any form and nothing is
        being verified. Add both below.
      <% } else if (!captchaSiteKeySet) { %>
        The <strong>site key is missing</strong>. That is the half the browser needs to draw the
        widget, so no challenge appears anywhere — a secret key on its own does nothing at all.
      <% } else { %>
        The <strong>secret key is missing</strong>. The challenge would appear on the page, but the
        server has nothing to verify the answer with, so it could not accept it.
      <% } %>

      <div class="conn-status">
        <span class="conn-pill<%= captchaSiteKeySet ? ' is-ok' : ' is-missing' %>">
          Site key <%= captchaSiteKeySet ? 'saved' : 'missing' %>
        </span>
        <span class="conn-pill<%= captchaSecretKeySet ? ' is-ok' : ' is-missing' %>">
          Secret key <%= captchaSecretKeySet ? 'saved' : 'missing' %>
        </span>
      </div>

      <div style="margin-top:9px;font-size:.8125rem">
        Get keys at <a href="https://www.google.com/recaptcha/admin/create" target="_blank" rel="noopener noreferrer">google.com/recaptcha/admin</a>.
        Choose <strong>reCAPTCHA v2</strong>, then either key type works here —
        <strong>"I'm not a robot" Checkbox</strong> is the simplest. Add the domain
        <code><%= helpers.absoluteUrl('/').replace(/^https?:\/\//, '').replace(/\/$/, '') %></code> to it,
        then paste both keys below and press <strong>Test reCAPTCHA keys</strong>.
      </div>
    </div>
  </div>
<% } %>

<% if (group === 'security' && captchaConfigured && captchaToggles.length) { %>
  <div class="alert alert-success" role="status">
    <svg><use href="#i-check-circle"/></svg>
    <div>
      <strong>CAPTCHA is configured</strong> and the forms you selected below are protected.
      <div class="conn-status">
        <span class="conn-pill is-ok">Site key saved</span>
        <span class="conn-pill is-ok">Secret key saved</span>
        <span class="conn-pill is-ok"><%= captchaToggles.length %> form<%= captchaToggles.length === 1 ? '' : 's' %> protected</span>
      </div>
    </div>
  </div>

  <%#
    The domain list, spelled out.

    Google refuses to draw the widget on a hostname that is not registered
    against the key, and it says so inside the widget's own iframe - which the
    page cannot read, and the server-side test cannot see either, because no
    token is ever produced. The console stays clean and the form simply has a
    blank space where the box should be, so it reads as a broken feature rather
    than a missing setting. Printing the exact hostnames is the only place this
    can be caught.
  %>
  <div class="alert alert-info" role="status">
    <svg><use href="#i-info"/></svg>
    <div>
      <strong>One more step, and it is the one that catches people:</strong>
      Google will only draw the box on a domain registered against this site key.
      If the box is missing, add <em>every</em> hostname you open the site on:

      <div class="conn-status">
        <% captchaDomains.forEach(function (domain) { %>
          <span class="conn-pill is-neutral"><%= domain %></span>
        <% }); %>
      </div>

      <div style="margin-top:9px;font-size:.8125rem">
        Open
        <a href="https://www.google.com/recaptcha/admin" target="_blank" rel="noopener noreferrer">google.com/recaptcha/admin</a>,
        pick this key, open <strong>Settings → Domains</strong>, and add them one per line. Google shows
        <em>"Localhost is not in the list of supported domains for this site key"</em> inside the widget
        when it is missing — that message is the confirmation, not a code fault.
      </div>
    </div>
  </div>
<% } %>

<% if (group === 'smtp' && !mailConfigured) { %>
  <div class="alert alert-warning" role="status">
    <svg><use href="#i-alert"/></svg>
    <div>
      <strong>Email is not configured, so nothing is being sent.</strong>
      Missing: <strong><%= mailMissing.join(', ') %></strong>.
      Order confirmations, status updates, contact-form alerts and quote requests are all skipped until
      this is filled in — the site works, it just sends no mail.
      <div style="margin-top:7px;font-size:.8125rem">
        For Hostinger, use <code>smtp.hostinger.com</code> on port <code>465</code> with SSL on, and the
        <strong>full email address</strong> as the username. The password field is a secret: leave it
        blank to keep what is saved.
      </div>
    </div>
  </div>
<% } %>

<%#
  Payment methods that are switched on but cannot be completed.

  A wallet with no receiving number renders "Send to (Personal)" at checkout
  and a manual method with no instructions leaves the customer with nothing to
  do. Both are withheld from customers rather than shown broken, so this is the
  only place the reason is visible - and it is invisible from the switch alone.
%>
<% if (group === 'payments') { %>
  <%
    var blocked = (payments.methods || []).filter(function (m) { return m.switchedOn && !m.enabled; });
    var live = (payments.methods || []).filter(function (m) { return m.enabled; });
  %>

  <% if (blocked.length) { %>
    <div class="alert alert-warning" role="status">
      <svg><use href="#i-alert"/></svg>
      <div>
        <strong>
          <%= blocked.length %> method<%= blocked.length === 1 ? ' is' : 's are' %> switched on but
          cannot be offered yet.
        </strong>
        Customers do not see them, because there is nothing for them to pay into:
        <div class="conn-status">
          <% blocked.forEach(function (m) { %>
            <span class="conn-pill is-warn"><%= m.label %> — <%= m.unusableReason %></span>
          <% }); %>
        </div>
        <div style="margin-top:9px;font-size:.8125rem">
          Fill in the details below and they appear at checkout on their own.
        </div>
      </div>
    </div>
  <% } %>

  <div class="alert alert-info" role="status">
    <svg><use href="#i-info"/></svg>
    <div>
      <strong><%= live.length %> method<%= live.length === 1 ? '' : 's' %> offered at checkout:</strong>
      <div class="conn-status">
        <% (payments.methods || []).forEach(function (m) { %>
          <span class="conn-pill <%= m.enabled ? 'is-ok' : 'is-neutral' %>"><%= m.label %></span>
        <% }); %>
      </div>
      <div style="margin-top:9px;font-size:.8125rem">
        <%
          // Which of these settle themselves and which need a human. The
          // distinction matters more than the list: an operator who thinks a
          // manual method is automatic stops checking, and the payments sit
          // unverified.
          var gatewayLive = payments.sslcommerz && payments.sslcommerz.enabled;
        %>
        <% if (gatewayLive) { %>
          <strong>SSLCommerz settles itself.</strong> Cards, wallets and net banking are confirmed
          by the gateway and the order is marked paid without anyone reviewing it. Everything else
          is a transfer the customer records and you verify by hand.
        <% } else { %>
          Every method here is a manual transfer the customer records and you verify by hand.
          To take money automatically, fill in the <strong>SSLCommerz</strong> credentials below and
          switch it on — it confirms its own payments, so nothing needs reviewing.
        <% } %>
      </div>
    </div>
  </div>

  <% if (payments.sslcommerz && payments.sslcommerz.switchedOn && !payments.sslcommerz.enabled) { %>
    <div class="alert alert-warning" role="status">
      <svg><use href="#i-alert"/></svg>
      <div>
        <strong>SSLCommerz is switched on but has no store credentials.</strong>
        Customers are not offered it, because they would be sent to a provider that has never heard
        of this store. Add the store ID and password below.
      </div>
    </div>
  <% } %>
<% } %>

<% if (group === 'smtp' && mailConfigured) { %>
  <div class="alert alert-success" role="status">
    <svg><use href="#i-check-circle"/></svg>
    <div>
      <strong>Email is configured.</strong> Send a test to confirm the credentials are accepted —
      a saved password is not the same as a working one.
    </div>
  </div>
<% } %>

<%#
  What the email header will actually contain.

  Shown because the two ways this goes wrong are both invisible from the
  settings alone: no logo at all (the header silently falls back to plain text),
  and an SVG logo, which looks perfect here and arrives as a broken image in
  every inbox because email clients refuse to render SVG.
%>
<% if (group === 'email') { %>
  <div class="panel" style="margin-bottom:20px">
    <div class="panel-head">
      <h2 style="margin:0;font-size:1rem">Email header preview</h2>
      <span style="font-size:.8125rem;color:var(--text-soft)">What every message will show at the top.</span>
    </div>
    <div class="panel-body">
      <div style="background:<%= settings.email_header_bg || '#ffffff' %>;border:1px solid var(--border);border-radius:12px;padding:26px;text-align:center">
        <% if (emailLogoUrl) { %>
          <img src="<%= emailLogoUrl %>" alt="<%= settings.site_name %>"
               style="width:<%= emailLogoWidth %>px;max-width:100%;height:auto">
        <% } else { %>
          <span style="font-size:21px;font-weight:800;color:#101223"><%= settings.site_name %></span>
        <% } %>
      </div>

      <% if (!emailLogoUrl && emailLogoMissingFile) { %>
        <div class="alert alert-warning" role="status" style="margin-top:14px;margin-bottom:0">
          <svg><use href="#i-alert"/></svg>
          <div>
            <strong>The logo file is missing.</strong>
            A path is saved but nothing exists at it, so the header would show a broken image.
            Upload the logo again above.
          </div>
        </div>
      <% } else if (!emailLogoUrl) { %>
        <div class="alert alert-warning" role="status" style="margin-top:14px;margin-bottom:0">
          <svg><use href="#i-alert"/></svg>
          <div>
            <strong>No logo will appear — the header shows the site name as text.</strong>
            Upload one above, or set the site logo under
            <a href="<%= settingsUrl %>?group=branding">Branding</a>.
          </div>
        </div>
      <% } else if (emailLogoIsSvg) { %>
        <div class="alert alert-warning" role="status" style="margin-top:14px;margin-bottom:0">
          <svg><use href="#i-alert"/></svg>
          <div>
            <strong>This logo is an SVG, and most email clients will not display it.</strong>
            Gmail, Outlook and Apple Mail all block SVG images, so recipients will see a broken
            image instead of your logo. Upload a <strong>PNG</strong> above — that is the format
            every client renders.
            <% if (emailLogoFromSite) { %>
              <div style="margin-top:7px;font-size:.8125rem">
                This is the site logo from <a href="<%= settingsUrl %>?group=branding">Branding</a>.
                An email logo set above takes priority over it.
              </div>
            <% } %>
          </div>
        </div>
      <% } else if (emailLogoFromSite) { %>
        <div class="alert alert-info" role="status" style="margin-top:14px;margin-bottom:0">
          <svg><use href="#i-info"/></svg>
          <div>
            No email logo is set, so this is the site logo from
            <a href="<%= settingsUrl %>?group=branding">Branding</a>. Upload one above to use a
            different image in emails.
          </div>
        </div>
      <% } else { %>
        <div style="margin-top:12px;font-size:.8125rem;color:var(--text-soft)">
          This is your email logo. Send a test from the <strong>SMTP</strong> tab to see the whole
          message.
        </div>
      <% } %>
    </div>
  </div>
<% } %>

<% if (group === 'google' && googleToggles.length && !googleConfigured) { %>
  <div class="alert alert-warning" role="status">
    <svg><use href="#i-alert"/></svg>
    <div>
      <strong>Google sign-in buttons are switched on but not configured.</strong>
      Add the client ID and client secret below. The buttons stay hidden until both are
      present, so nothing is broken in the meantime - customers just use email and password.
      <div style="margin-top:7px;font-size:.8125rem">
        Authorised redirect URI must be exactly
        <code><%= helpers.absoluteUrl('/auth/google/callback') %></code>
      </div>
    </div>
  </div>
<% } %>

<% if (group === 'google' && googleConfigured && googleToggles.length) { %>
  <div class="alert alert-success" role="status">
    <svg><use href="#i-check-circle"/></svg>
    <div>Google sign-in is configured and the buttons are live on the pages you selected below.</div>
  </div>
<% } %>

<div class="panel">
  <div class="panel-head">
    <h2 style="font-size:1rem;font-weight:700;margin:0"><%= currentGroupLabel %></h2>
    <span style="font-size:.8125rem;color:var(--text-soft)">
      <%= fields.length %> setting<%= fields.length === 1 ? '' : 's' %>
    </span>
  </div>

  <form method="post" action="<%= settingsUrl %>" enctype="multipart/form-data" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="group" value="<%= group %>">

    <div class="panel-body">
      <% fields.forEach(function (f) { %>
        <%
          var hasError = errors && errors[f.key];
          var controlId = 'set-' + f.key;
        %>
        <div class="setting-row">
          <div class="setting-text">
            <label class="setting-label" for="<%= controlId %>"><%= f.label %></label>
            <% if (f.help) { %>
              <p class="setting-help"><%= f.help %></p>
            <% } %>
            <% if (hasError) { %>
              <p class="form-error" style="margin-top:6px"><%= errors[f.key] %></p>
            <% } %>
          </div>

          <div class="setting-control">
            <% if (f.type === 'boolean') { %>
              <label class="switch" data-on="On" data-off="Off">
                <input type="checkbox" id="<%= controlId %>" name="<%= f.key %>" value="1"
                       <%= f.value === '1' ? 'checked' : '' %>>
                <span class="track"></span>
                <span class="switch-state"><%= f.value === '1' ? 'On' : 'Off' %></span>
              </label>

            <% } else if (f.type === 'file') { %>
              <%#
                Brand assets. The file input is named after the setting key so
                multer leaves it on file.fieldname and the controller can match
                it back. Leaving it empty keeps the stored file; ticking remove
                clears it and the bundled default takes over again.
              %>
              <%
                var currentFile = f.value ? helpers.url(f.value) : '';
                // Only the site's own brand assets have a bundled default. Any
                // other file setting (payment marks, for instance) has none, so
                // showing the WooBD logo there would be a lie.
                var brandFallbacks = {
                  favicon: '/assets/img/favicon.svg',
                  logo_dark: '/assets/img/logo-dark.svg',
                  logo_footer: '/assets/img/logo-dark.svg',
                  logo_light: '/assets/img/logo-light.svg'
                };
                var fallbackFile = brandFallbacks[f.key] ? helpers.url(brandFallbacks[f.key]) : '';
              %>
              <div class="brand-field">
                <div class="brand-preview">
                  <% if (currentFile || fallbackFile) { %>
                    <img id="<%= controlId %>-preview" src="<%= currentFile || fallbackFile %>"
                         alt="<%= f.label %> preview">
                  <% } else { %>
                    <img id="<%= controlId %>-preview" src="" alt="" hidden>
                    <span class="brand-empty" id="<%= controlId %>-empty">No file</span>
                  <% } %>
                </div>
                <div style="flex:1;min-width:0">
                  <input type="file" class="form-control" id="<%= controlId %>" name="<%= f.key %>"
                         accept="image/png,image/jpeg,image/webp,image/svg+xml,image/gif,image/avif"
                         data-preview="<%= controlId %>-preview"
                         data-max-mb="<%= uploadLimits.logos.maxMb %>">
                  <p class="form-hint">
                    <% if (currentFile) { %>
                      Custom file in use. Choose a new one to replace it.
                    <% } else if (fallbackFile) { %>
                      Using the bundled default — shown above.
                    <% } else { %>
                      No file uploaded — the method is shown as a text badge instead.
                    <% } %>
                    PNG, JPG, WebP, GIF, AVIF or SVG, up to <%= uploadLimits.logos.maxMb %> MB.
                  </p>
                  <% if (currentFile) { %>
                    <label class="checkbox" style="margin-top:8px">
                      <input type="checkbox" name="clear_<%= f.key %>" value="1">
                      <span>Remove this file and go back to the bundled default</span>
                    </label>
                  <% } %>
                </div>
              </div>

            <% } else if (f.isSecret) { %>
              <%#
                A stored secret is never sent to the browser, so the field is
                always blank. Without a visible confirmation an operator cannot
                tell whether their key saved - which reads as "it did not save".
                Show where the value comes from and a masked preview of it.
              %>
              <% if (f.hasValue) { %>
                <span class="secret-state">
                  <svg style="width:13px;height:13px"><use href="#i-check-circle"/></svg>
                  Saved<% if (f.masked) { %> <code class="secret-mask"><%= f.masked %></code><% } %>
                </span>
              <% } else if (f.fromEnv) { %>
                <span class="secret-state is-env">
                  <svg style="width:13px;height:13px"><use href="#i-info"/></svg>
                  Using the value from your environment
                  <% if (f.masked) { %><code class="secret-mask"><%= f.masked %></code><% } %>
                </span>
              <% } else { %>
                <span class="secret-state is-missing">
                  <svg style="width:13px;height:13px"><use href="#i-alert"/></svg>
                  Not set — this feature is inactive
                </span>
              <% } %>
              <input type="password" class="form-control" id="<%= controlId %>" name="<%= f.key %>"
                     value="" autocomplete="new-password"
                     placeholder="<%= f.effective ? 'Leave blank to keep the current value' : 'Paste your key here' %>">

            <% } else if (f.type === 'textarea') { %>
              <textarea class="form-control" id="<%= controlId %>" name="<%= f.key %>" rows="5"><%= f.value %></textarea>

            <% } else if (f.type === 'select') { %>
              <select class="form-control" id="<%= controlId %>" name="<%= f.key %>">
                <% (f.options || []).forEach(function (opt) { %>
                  <option value="<%= opt %>" <%= String(f.value) === String(opt) ? 'selected' : '' %>><%= opt %></option>
                <% }); %>
              </select>

            <% } else if (f.type === 'number') { %>
              <input type="number" class="form-control" id="<%= controlId %>" name="<%= f.key %>"
                     value="<%= f.value %>" min="0" step="1">

            <% } else if (isColourField(f.key, f.value)) { %>
              <%#
                A colour setting: the hex field stays authoritative, with a
                picker beside it.

                The check is on the key name as well as the value, so a colour
                field that is still empty gets a picker too. Testing the value
                alone meant a freshly added colour setting rendered as a plain
                text box with no hint that a hex code was expected.
              %>
              <div class="input-group">
                <input type="text" class="form-control" id="<%= controlId %>" name="<%= f.key %>"
                       value="<%= f.value %>" maxlength="7" spellcheck="false" placeholder="#5b21f0">
                <input type="color" class="form-control" style="max-width:56px;padding:3px;cursor:pointer"
                       value="<%= isHexColour(f.value) ? f.value : '#ffffff' %>"
                       data-colour-picker="<%= controlId %>" aria-label="Pick <%= f.label %>">
              </div>

            <% } else { %>
              <input type="text" class="form-control" id="<%= controlId %>" name="<%= f.key %>"
                     value="<%= f.value %>" spellcheck="false">
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="panel-foot" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
      <p style="margin:0;font-size:.8125rem;color:var(--text-soft)">
        <% if (fields.some(function (f) { return f.isSecret; })) { %>
          Saved secrets are never sent to the browser. Leave a secret field blank to keep it unchanged.
        <% } else { %>
          Changes take effect immediately for new requests.
        <% } %>
      </p>
      <button type="submit" class="btn btn-primary">
        <svg><use href="#i-check"/></svg>
        Save <%= currentGroupLabel %>
      </button>
    </div>
  </form>

  <%#
    Its own form, after the settings form closes. A button inside would submit
    the settings form, and testing the keys should not also save every field on
    the tab - or worse, save a half-filled one.
  %>
  <% if (group === 'security') { %>
    <form method="post" action="<%= helpers.url('/' + adminPath + '/settings/test-captcha') %>"
          style="margin-top:14px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline">
        <svg><use href="#i-shield"/></svg>
        Test reCAPTCHA keys
      </button>
      <span style="margin-left:12px;font-size:.8125rem;color:var(--text-soft)">
        Checks the saved keys against Google and tells you what it says.
      </span>
    </form>
  <% } %>

  <%#
    Sending a test is the only way to tell "the password is saved" from "the
    password works". Nodemailer's error names the exact failure - wrong
    password, unreachable host, refused port - and none of that is visible from
    the settings alone.
  %>
  <% if (group === 'smtp') { %>
    <form method="post" action="<%= helpers.url('/' + adminPath + '/settings/test-mail') %>"
          style="margin-top:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline">
        <svg><use href="#i-mail"/></svg>
        Send a test email
      </button>
      <label class="form-label" for="test_to" style="margin:0">Send it to</label>
      <input type="email" id="test_to" name="to" class="form-control" style="max-width:260px"
             placeholder="<%= settings.mail_from_email || site.email %>">
      <span style="font-size:.8125rem;color:var(--text-soft)">
        Leave blank to use the From address.
      </span>
    </form>
  <% } %>
</div>
