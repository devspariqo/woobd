<%
  const c = counts || {};
  const num = function (v) { return Number(v || 0); };
  const cur = site.currency;
  const url = function (p) { return helpers.url('/' + adminPath + '/subscriptions' + p); };
  const tabs = [
    ['', 'All', num(c.total)],
    ['active', 'Active', num(c.active)],
    ['past_due', 'Past due', num(c.past_due)],
    ['cancelled', 'Cancelled', num(c.cancelled)]
  ];
%>

<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr))">
  <div class="stat-tile">
    <div class="ico tone-primary"><svg><use href="#i-repeat"/></svg></div>
    <div><div class="value"><%= num(c.active) %></div><div class="label">Active plans</div></div>
  </div>
  <div class="stat-tile">
    <div class="ico tone-success"><svg><use href="#i-trending-up"/></svg></div>
    <div><div class="value"><%= helpers.money(c.mrr, cur) %></div><div class="label">Monthly recurring</div></div>
  </div>
  <div class="stat-tile">
    <div class="ico tone-warning"><svg><use href="#i-clock"/></svg></div>
    <div><div class="value"><%= (dueSoon || []).length %></div><div class="label">Due in 30 days</div></div>
  </div>
  <div class="stat-tile">
    <div class="ico tone-danger"><svg><use href="#i-alert"/></svg></div>
    <div><div class="value"><%= num(c.past_due) %></div><div class="label">Past due</div></div>
  </div>
</div>

<% if (dueSoon && dueSoon.length) { %>
  <div class="panel" style="margin-bottom:20px">
    <div class="panel-head">
      <h2 style="font-size:.9375rem;font-weight:700;margin:0">Renewing in the next 30 days</h2>
      <span style="font-size:.8125rem;color:var(--text-soft)"><%= dueSoon.length %> plan<%= dueSoon.length === 1 ? '' : 's' %></span>
    </div>
    <div class="table-wrap">
      <table class="dash-table">
        <thead><tr><th>Plan</th><th>Customer</th><th>Renews</th><th class="num">Amount</th><th class="num">Action</th></tr></thead>
        <tbody>
          <% dueSoon.forEach(function (sub) { %>
            <tr>
              <td class="strong"><%= sub.plan_name %></td>
              <td style="font-size:.8438rem"><%= sub.customer_name || '—' %></td>
              <td style="font-size:.8125rem"><%= helpers.formatDate(sub.next_billing_at) %></td>
              <td class="num strong"><%= helpers.money(sub.amount, cur) %></td>
              <td class="num">
                <form method="post" action="<%= url('/' + sub.id) %>" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="advance">
                  <button type="submit" class="btn btn-primary btn-sm"
                          data-confirm="Roll this subscription forward one billing cycle?">Advance</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<div class="tab-bar" style="margin-bottom:20px">
  <% tabs.forEach(function (tab) { %>
    <a href="<%= url(tab[0] ? '?status=' + tab[0] : '') %>" class="<%= (activeStatus || '') === tab[0] ? 'active' : '' %>">
      <%= tab[1] %><% if (tab[2]) { %><span class="tab-count"><%= tab[2] %></span><% } %>
    </a>
  <% }); %>
</div>

<div class="panel">
  <div class="panel-head">
    <form class="toolbar" method="get" action="<%= url('') %>"
          style="margin:0;padding:0;border:0;box-shadow:none;background:transparent">
      <% if (activeStatus) { %><input type="hidden" name="status" value="<%= activeStatus %>"><% } %>
      <div class="search-box">
        <svg><use href="#i-search"/></svg>
        <input type="search" name="q" class="form-control" value="<%= search %>"
               placeholder="Plan or customer…" aria-label="Search subscriptions">
      </div>
      <button type="submit" class="btn btn-outline btn-sm">Search</button>
    </form>
  </div>

  <% if (subscriptions && subscriptions.length) { %>
    <div class="table-wrap">
      <table class="dash-table">
        <thead>
          <tr><th>Plan</th><th>Customer</th><th>Cycle</th><th>Next billing</th><th>Status</th><th class="num">Amount</th><th class="num">Actions</th></tr>
        </thead>
        <tbody>
          <% subscriptions.forEach(function (sub) { %>
            <tr>
              <td class="strong"><%= sub.plan_name %></td>
              <td style="font-size:.8438rem">
                <%= sub.customer_name || '—' %>
                <div style="font-size:.75rem;color:var(--text-soft);margin-top:2px;word-break:break-all"><%= sub.customer_email %></div>
              </td>
              <td style="font-size:.8125rem"><%= helpers.humanise(sub.billing_cycle) %></td>
              <td style="font-size:.8125rem">
                <%= sub.next_billing_at ? helpers.formatDate(sub.next_billing_at) : '—' %>
              </td>
              <td><span class="pill pill-<%= helpers.statusTone(sub.status) %>"><%= helpers.humanise(sub.status) %></span></td>
              <td class="num strong"><%= helpers.money(sub.amount, cur) %></td>
              <td>
                <div class="actions">
                  <% if (sub.status === 'active') { %>
                    <form method="post" action="<%= url('/' + sub.id) %>" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="action" value="pause">
                      <button type="submit" class="btn btn-ghost btn-sm">Pause</button>
                    </form>
                    <form method="post" action="<%= url('/' + sub.id) %>" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="action" value="cancel">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)"
                              data-confirm="Cancel this subscription? Billing stops at the end of the period.">Cancel</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="<%= url('/' + sub.id) %>" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="action" value="resume">
                      <button type="submit" class="btn btn-outline btn-sm">Resume</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pager.totalPages > 1) { %>
      <div class="panel-foot">
        <%- include('../partials/pagination', { baseUrl: '/' + adminPath + '/subscriptions' }) %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <div class="ico"><svg><use href="#i-repeat"/></svg></div>
      <h3>No subscriptions<%= (search || activeStatus) ? ' match those filters' : ' yet' %></h3>
      <p>Recurring plans appear here when a customer orders a monthly package.</p>
    </div>
  <% } %>
</div>
