<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Under maintenance' %> - <%= site.name %></title>
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" type="image/svg+xml" href="<%= site.favicon %>">
  <link href="https://fonts.googleapis.com/css2?family=<%= encodeURIComponent(fonts.heading).replace(/%20/g, '+') %>:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= helpers.url('/assets/css/theme.css') %>">
  <style>
    :root {
      --primary: <%= theme.primary %>;
      --primary-dark: <%= theme.primaryDark %>;
      --secondary: <%= theme.secondary %>;
      --font-heading: '<%= fonts.heading %>', system-ui, sans-serif;
    }
    body { min-height: 100vh; display: grid; place-items: center; padding: 24px; text-align: center; }
  </style>
</head>
<body>
  <%# Reached only from /maintenance-preview, which staff use to check the
      switch actually works. Without this note the page is indistinguishable
      from the real thing and they would think the site had gone down. %>
  <% if (typeof preview !== 'undefined' && preview) { %>
    <div class="maintenance-banner" style="position:fixed;top:0;left:0;right:0;border-radius:0">
      <%# Inline, not <use href="#i-alert"> - this page renders standalone and
          never loads the icon sprite, so a reference would show nothing. %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span><strong>Preview.</strong> This is what visitors see while maintenance mode is on.</span>
      <a href="<%= helpers.url('/') %>" class="btn btn-sm btn-outline">Back to the site</a>
    </div>
  <% } %>

  <div style="max-width:620px">
    <div style="width:88px;height:88px;margin:0 auto 30px;display:grid;place-items:center;border-radius:26px;background:var(--gradient-soft);color:var(--primary)">
      <svg style="width:42px;height:42px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
    </div>

    <h1 style="font-size:2.25rem;margin-bottom:16px"><%= title || 'We will be right back' %></h1>

    <p style="font-size:1.0625rem;line-height:1.75;margin-bottom:34px">
      <%= message %>
    </p>

    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a href="<%= helpers.url('/') %>" class="btn btn-primary">Check again</a>
      <a href="<%= site.whatsappLink %>" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp us</a>
    </div>

    <p style="font-size:.8438rem;color:var(--text-soft);margin-top:40px;line-height:1.7">
      <%= site.name %> &middot; <%= site.address %><br>
      <a href="mailto:<%= site.email %>"><%= site.email %></a> &middot;
      <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a>
    </p>
  </div>
</body>
</html>
