<section class="section" style="padding:100px 0">
  <div class="container container-narrow text-center">
    <div style="font-family:var(--font-heading);font-size:7rem;font-weight:800;line-height:1;background:linear-gradient(135deg,var(--danger),var(--secondary));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:-.04em">
      500
    </div>

    <h1 style="margin:22px 0 16px;font-size:2rem">Something went wrong on our side</h1>

    <p style="font-size:1.0625rem;max-width:520px;margin:0 auto 34px">
      <%= typeof message !== 'undefined' && message && config.isDev
            ? message
            : 'We have logged the problem and will look into it. Please try again in a moment.' %>
    </p>

    <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
      <a href="<%= helpers.url(currentUrl || '/') %>" class="btn btn-primary btn-lg">
        <svg><use href="#i-refresh"/></svg>
        Try again
      </a>
      <a href="<%= helpers.url('/') %>" class="btn btn-outline btn-lg">Back to homepage</a>
    </div>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <pre style="text-align:left;margin-top:44px;padding:22px;background:var(--bg-alt);border:1px solid var(--border);border-radius:var(--radius);overflow:auto;font-size:.8125rem;line-height:1.6;max-height:420px"><%= stack %></pre>
    <% } %>
  </div>
</section>
