# ==========================================================================
# WooBD.Com - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=production
APP_NAME=WooBD.Com
APP_URL=https://woobd.com
# Do NOT set PORT on Hostinger - the host injects it. Left here for local use.
PORT=3000

# Where the app is mounted behind a reverse proxy. Use "/" when the domain
# root is proxied to this app. Change to "/subfolder" only if you install it
# under a subdirectory.
APP_BASE_PATH=/

# --- Session / Security ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to boot in production with the placeholder value.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_NAME=woobd.sid
# Trust the first hop (Hostinger's TLS terminator). Required for Secure cookies.
TRUST_PROXY=1

# Attach `Secure` to session cookies. MUST be false only on plain-HTTP localhost,
# otherwise the browser silently drops the cookie and every login appears to fail.
COOKIE_SECURE=true

# --- Database (MySQL / MariaDB) -------------------------------------------
# INSIDE Hostinger the host MUST be 127.0.0.1 (NOT localhost - that resolves to
# the IPv6 loopback ::1, which the DB user is not granted).
# The password must be percent-encoded: # -> %23, @ -> %40, / -> %2F, : -> %3A
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=woobd
DB_USER=woobd_user
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=10

# --- Google reCAPTCHA v2 (checkbox) ---------------------------------------
# Applied to: customer sign-in, customer sign-up, admin login, contact form.
# Leave the keys blank to disable reCAPTCHA (useful for local development).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google OAuth (customer "Sign in with Google") ------------------------
# Authorised redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (transactional mail: verification, password reset, order updates) -
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@woobd.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM_NAME=WooBD.Com
MAIL_FROM_EMAIL=hello@woobd.com

# --- Live Chat Assistant (XKiro OpenAI-compatible endpoint) ---------------
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1/chat/completions
XKIRO_MODEL=qwen/qwen3.8-omni-flash:free

# --- Installer (`npm run setup` only) -------------------------------------
# Password given to the three seeded staff accounts on a fresh install.
#
# There is no default. Leave this unset and the installer generates a random
# password and prints it once. Never commit a real one: this file is tracked.
#
# QUOTE IT. An unquoted `#` starts a comment in .env, so
#   SEED_PASSWORD=abc#def   -> becomes "abc"  (silently truncated)
# and you will not be able to sign in with the password you think you set.
# Ignored once the accounts already exist - re-running setup never resets a
# password. Change them from the admin panel after your first sign-in.
SEED_PASSWORD=
